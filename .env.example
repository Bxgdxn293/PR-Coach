# Copy to .env (never commit .env). EXPO_PUBLIC_* values are bundled into the app, so only put
# public keys here: the Supabase anon key and the RevenueCat *public* SDK keys. Never the service role key.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
EXPO_PUBLIC_RC_IOS_KEY=appl_XXXXXXXXXXXX
EXPO_PUBLIC_RC_ANDROID_KEY=goog_XXXXXXXXXXXX
# Development only: 1 = unlock Premium screens in Expo Go (ignored in release builds)
EXPO_PUBLIC_DEV_PREMIUM=0
EXPO_PUBLIC_PRIVACY_URL=https://example.com/privacy
EXPO_PUBLIC_TERMS_URL=https://example.com/terms
